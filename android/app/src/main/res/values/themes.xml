<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MW2" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">#0B0E12</item>
        <item name="colorPrimary">#1B2129</item>
        <item name="colorPrimaryDark">#0B0E12</item>
        <item name="colorAccent">#FF7A1A</item>
        <item name="android:textColorPrimary">#F0F3F6</item>
        <item name="android:textColorSecondary">#9AA5B1</item>
    </style>

    <style name="SectionHeading">
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">#FF7A1A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SettingLabel">
        <item name="android:paddingTop">10dp</item>
        <item name="android:textColor">#E4E9EE</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingHint">
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#7D8792</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SettingSwitch">
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textColor">#E4E9EE</item>
        <item name="android:textSize">14sp</item>
        <item name="track">@drawable/switch_track</item>
        <item name="thumb">@drawable/switch_thumb</item>
    </style>
    <style name="MenuEntry">
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textColor">#E8EAED</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
